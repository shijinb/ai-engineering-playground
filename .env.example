# aiplay reads the environment only. Copy to .env (git-ignored) and load it: set -a; source .env; set +a
# Only the providers you use need keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# AIPLAY_ANTHROPIC_MODEL=claude-opus-5-5
# AIPLAY_ANTHROPIC_EFFORT=medium
# AIPLAY_ANTHROPIC_FALLBACKS=off
AIPLAY_OPENAI_MODEL=
AIPLAY_GEMINI_MODEL=
